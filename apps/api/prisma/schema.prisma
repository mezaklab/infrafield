generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
  USUARIO
}

enum TicketStatus {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_USUARIO
  RESOLVIDO
  CANCELADO
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  INACTIVE
  CRITICAL
}

enum PeripheralCategory {
  COMPUTADOR
  IMPRESSORA
  SCANNER
  MONITOR
}

enum PeripheralSubcategory {
  DESKTOP
  NOTEBOOK
}

enum VisitStatus {
  PLANEJADA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum VisitAssetStatus {
  ESPERADO
  ENCONTRADO
  AUSENTE
  NOVO
}

enum VisitPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum VisitType {
  PREVENTIVA
  CORRETIVA
  INSTALACAO
  INSPECAO
}

enum ChecklistFieldType {
  YES_NO
  TEXT
  NUMBER
  SELECT
  PHOTO
}

enum IssueSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_ANALYSIS
  IN_PROGRESS
  RESOLVED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  locations   Location[]
  assets      Asset[]
  peripherals Peripheral[]
  visits      Visit[]
  issues      Issue[]
  tickets     Ticket[]

  @@map("companies")
}

model Location {
  id        String  @id @default(uuid())
  name      String
  building  String?
  floor     String?
  room      String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  parentId String?    @map("parent_id")
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  assets      Asset[]
  peripherals Peripheral[]
  visits      Visit[]
  issues      Issue[]
  tickets     Ticket[]

  @@map("locations")
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  username  String? @unique
  password  String
  role      Role    @default(TECHNICIAN)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets          Asset[]
  peripherals     Peripheral[]
  visits          Visit[]
  reportedIssues  Issue[]
  authoredTickets Ticket[]        @relation("TicketAuthor")
  assignedTickets Ticket[]        @relation("TicketTechnician")
  ticketMessages  TicketMessage[]

  @@map("users")
}

model Asset {
  id            String      @id @default(uuid())
  name          String
  code          String      @unique
  assetTag      String? // Patrimônio
  ownershipType String?     @default("PROPRIO") // Tipo de Patrimônio: 'PROPRIO' | 'LOCADO'
  rentalCompany String?     @map("rental_company") // Empresa Locadora
  serialNumber  String?
  hostname      String?
  ipAddress     String?
  category      String
  status        AssetStatus @default(OPERATIONAL)
  imageUrl      String?
  wifiBands     String? // Frequência e Banda Wi-Fi (Ex: '2.4GHz / 5GHz')

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  visitAssets        VisitAsset[]
  checklistResponses ChecklistResponse[]
  issues             Issue[]
  tickets            Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}

model Visit {
  id            String        @id @default(uuid())
  protocol      String        @unique
  client        String
  address       String
  status        VisitStatus   @default(PLANEJADA)
  priority      VisitPriority @default(MEDIA)
  type          VisitType     @default(INSPECAO)
  scheduledDate DateTime
  scheduledTime String?
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  visitAssets        VisitAsset[]
  checklistResponses ChecklistResponse[]
  issues             Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visits")
}

model VisitAsset {
  id        String           @id @default(uuid())
  visitId   String
  visit     Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  assetId   String?
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  status    VisitAssetStatus @default(ESPERADO)
  notes     String?
  photoUrl  String?
  checkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visit_assets")
}

model ChecklistTemplate {
  id          String          @id @default(uuid())
  name        String
  description String?
  category    String          @default("Geral")
  isActive    Boolean         @default(true)
  items       ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_templates")
}

model ChecklistItem {
  id         String             @id @default(uuid())
  templateId String
  template   ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  fieldType  ChecklistFieldType @default(YES_NO)
  isRequired Boolean            @default(false)
  options    String? // JSON string array for SELECT options
  order      Int                @default(0)

  responses ChecklistResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_items")
}

model ChecklistResponse {
  id              String        @id @default(uuid())
  visitId         String
  visit           Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  value           String
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_responses")
}

model Issue {
  id             String        @id @default(uuid())
  protocol       String?
  title          String
  description    String
  severity       IssueSeverity @default(MEDIUM)
  status         IssueStatus   @default(OPEN)
  recommendation String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  reportedById String?
  reportedBy   User?   @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("issues")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("ALERT")
  isRead    Boolean  @default(false)
  assetId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model Peripheral {
  id             String                 @id @default(uuid())
  name           String
  code           String                 @unique
  assetTag       String? // Patrimônio
  ownershipType  String?                @default("PROPRIO") // Tipo de Patrimônio: 'PROPRIO' | 'LOCADO'
  rentalCompany  String?                @map("rental_company") // Empresa Locadora
  serialNumber   String?
  category       PeripheralCategory     @default(COMPUTADOR)
  subcategory    PeripheralSubcategory? // DESKTOP ou NOTEBOOK (quando category == COMPUTADOR)
  brand          String?
  model          String?
  ipAddress      String? // Endereço IP para monitoramento via Poller (ICMP Ping)
  specifications String? // Especificações técnicas / Observações
  status         AssetStatus            @default(OPERATIONAL)
  imageUrl       String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("peripherals")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  user      String
  role      String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Ticket {
  id          String         @id @default(uuid())
  code        String         @unique
  subject     String
  description String
  status      TicketStatus   @default(ABERTO)
  priority    TicketPriority @default(MEDIA)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TicketTechnician", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content     String
  attachments String? // JSON string array of upload URLs

  createdAt DateTime @default(now())

  @@map("ticket_messages")
}

model Settings {
  id                  String   @id @default(uuid())
  whatsapp_group_id   String?
  whatsapp_group_name String?
  whatsapp_status     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

model Sector {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectors")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

# PostgreSQL Database Configuration
POSTGRES_USER=infrafield_user
POSTGRES_PASSWORD=infrafield_password
POSTGRES_DB=infrafield_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://infrafield_user:infrafield_password@localhost:5432/infrafield_db?schema=public"

# API Configuration
PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333

# Frontend Web Configuration
VITE_API_URL=http://localhost:3333/api

# Password recovery / SMTP (optional in development; required in production)
APP_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=InfraField
SMTP_FROM_EMAIL=

# Monitoramento de rede baseado em MAC (disabled | local | remote-agent futuro)
NETWORK_DISCOVERY_MODE=local
# Somente CIDRs autorizados; múltiplos valores separados por vírgula. Limite atual: /22 ou menor.
DISCOVERY_SUBNETS=192.168.18.0/24
DISCOVERY_INTERVAL_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=30
DISCOVERY_SWEEP_CONCURRENCY=32
HEALTH_CHECK_TIMEOUT_SECONDS=3
OFFLINE_FAILURE_THRESHOLD=3
DEGRADED_LATENCY_MS=150
# Mantém ativos antigos sem MAC no poller baseado em IP durante a transição.
LEGACY_IP_POLLER_ENABLED=true
LEGACY_IP_POLLER_INTERVAL_SECONDS=60

# Bootstrap idempotente do primeiro Super Admin (senha real somente no ambiente)
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_COMPANY_NAME=InfraField
# Confirmação exigida apenas ao executar npm --workspace=apps/api run data:clear-demo
CONFIRM_CLEAR_OPERATIONAL_DATA=

# Google Custom Search API Configuration
GOOGLE_API_KEY="SUA_CHAVE_AQUI"
GOOGLE_SEARCH_ENGINE_ID="SEU_CX_AQUI"

# InfraField Lens (processamento local por padrão; imagens só saem do servidor no modo http)
ASSET_OCR_PROVIDER=local-tesseract
ASSET_OCR_LANGUAGES=eng
ASSET_BARCODE_PROVIDER=local-zxing
ASSET_VISION_PROVIDER=disabled
ASSET_VISION_ENDPOINT=
ASSET_VISION_API_KEY=
ASSET_LENS_MAX_IMAGE_MB=8

# URL pública do frontend (usada em links enviados via Telegram, e-mail, etc.)
APP_BASE_URL="http://localhost:5173"

# Telegram Notifications
# Create a bot with BotFather and get the token
TELEGRAM_BOT_TOKEN="SEU_TOKEN_AQUI"
# To get the group ID, add the bot to the group, send a message and call the /getUpdates endpoint
TELEGRAM_CHAT_ID="-1000000000000"

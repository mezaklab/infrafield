# PostgreSQL Database Configuration
POSTGRES_USER=infrafield_user
POSTGRES_PASSWORD=infrafield_password
POSTGRES_DB=infrafield_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://infrafield_user:infrafield_password@localhost:5432/infrafield_db?schema=public"

# API Configuration
PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333

# Frontend Web Configuration
VITE_API_URL=http://localhost:3333/api

# Google Custom Search API Configuration
GOOGLE_API_KEY="SUA_CHAVE_AQUI"
GOOGLE_SEARCH_ENGINE_ID="SEU_CX_AQUI"

# WhatsApp / Evolution API — Notificação de Chamados
# WHATSAPP_API_URL: URL interna do container Evolution API
# WHATSAPP_TOKEN: API Key configurada no container (AUTHENTICATION_API_KEY)
# WHATSAPP_NOTIFY_GROUP: ID do grupo WhatsApp (formato: XXXXXXXXXXX@g.us)
WHATSAPP_API_URL=http://localhost:8080/message/sendText/infrafield-bot
WHATSAPP_TOKEN=SEU_TOKEN_AQUI
WHATSAPP_NOTIFY_GROUP=SEU_GRUPO_ID@g.us
EVOLUTION_SERVER_URL=http://localhost:8080
